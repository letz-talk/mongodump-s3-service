# mongo: replica set members (comma separated host:port); dump is read from a secondary when possible
MONGO_HOST=172.24.0.110:27017,172.24.0.102:27017
REPLICA_SET=dbrs
READ_PREFERENCE=secondaryPreferred
MONGO_USER=user
MONGO_PASSWORD=pass
AUTH_DB=admin

# S3 (Backblaze B2)
ACCESS_KEY_ID=key_id
SECRET_ACCESS_KEY=secret
ENDPOINT=https://s3.eu-central-003.backblazeb2.com
BUCKET_NAME=backup-letz
# archives go to s3://$BUCKET_NAME/mongodump/$BACKUP_NAME/ (+ status.json, read by chat_health)
BACKUP_NAME=prod-fin-1

# dump smaller than this is treated as failed
MIN_DUMP_SIZE_MB=100

# cron in container time zone (TZ)
# Бэкап каждый час: prod-fin-1 — чётные часы UTC (0 */2 * * *), pay-se-1 — нечётные (0 1-23/2 * * *)
TZ=UTC
CRON_EXPRESSION=0 */2 * * *
